# Skopiuj do .env.local i wpisz klucz z https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model do analizy. Domyślnie claude-haiku-4-5 (najtańszy). Lepsza jakość: claude-sonnet-5-5 albo claude-opus-5-5.
ANTHROPIC_MODEL=claude-haiku-4-5

# Turso. Te same wartości ustaw na Vercelu.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
