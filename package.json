{
  "name": "skincare",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./scripts/test-setup.mjs --test \"src/**/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm traceability",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm build && pnpm test:e2e",
    "traceability": "node scripts/check-traceability.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@libsql/client": "0.18.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.0"
}
